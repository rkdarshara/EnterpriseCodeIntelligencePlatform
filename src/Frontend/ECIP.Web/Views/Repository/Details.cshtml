@model ECIP.Web.ViewModels.RepositoryWorkspaceViewModel
@{
    ViewData["Title"] = "Repository Details";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Repository Workspace</a></li>
        <li class="breadcrumb-item active" aria-current="page">Repository Details</li>
    </ol>
</nav>

@if (Model.SelectedRepository is not null)
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h4 class="fw-semibold mb-1">@Model.SelectedRepository.Name</h4>
                    <p class="text-muted mb-0">@Model.SelectedRepository.Description</p>
                </div>
                <span class="badge bg-success-subtle text-success">@Model.SelectedRepository.Status</span>
            </div>
            <div class="row g-3">
                <div class="col-md-6"><strong>Current Branch:</strong> @Model.SelectedRepository.Branch</div>
                <div class="col-md-6"><strong>Repository Type:</strong> @Model.SelectedRepository.RepositoryType</div>
                <div class="col-md-6"><strong>Local Path:</strong> @Model.SelectedRepository.LocalPath</div>
                <div class="col-md-6"><strong>Last Scan:</strong> @(Model.SelectedRepository.LastScanDate?.ToString("g") ?? "Not scanned")</div>
                <div class="col-md-6"><strong>Number of Files:</strong> 0</div>
                <div class="col-md-6"><strong>Projects:</strong> 0</div>
                <div class="col-md-6"><strong>Languages:</strong> N/A</div>
                <div class="col-md-6"><strong>Status:</strong> @Model.SelectedRepository.Status</div>
            </div>
        </div>
    </div>
}
